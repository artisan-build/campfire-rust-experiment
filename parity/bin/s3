#!/usr/bin/env bash
# MinIO in Docker, so `crates/storage/tests/s3.rs` can run the S3 service against a real S3 API
# rather than a fake. It lives on its own Docker network so the toolchain container can reach it
# by name (the tests are run inside that container in CI and locally on hosts without Rust).
#
#   parity/bin/s3 up                       # start it and create the bucket
#   eval "$(parity/bin/s3 env)"            # export CAMPFIRE_TEST_S3_* for a host-side cargo
#   parity/bin/s3 env --network            # the same, addressed as http://minio:9000
#   parity/bin/s3 down
#
# The credentials are MinIO's defaults and are for tests only, like parity/.env.reference's keys.
set -euo pipefail

NETWORK=campfire-storage-test
CONTAINER=campfire-minio
BUCKET=campfire-test
PORT=9100
ROOT_USER=campfireminio
ROOT_PASSWORD=campfireminio

case "${1:-}" in
up)
  docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
  if ! docker inspect "$CONTAINER" >/dev/null 2>&1; then
    docker run -d --name "$CONTAINER" --network "$NETWORK" --network-alias minio \
      -p "${PORT}:9000" \
      -e "MINIO_ROOT_USER=${ROOT_USER}" -e "MINIO_ROOT_PASSWORD=${ROOT_PASSWORD}" \
      docker.io/minio/minio:latest server /data >/dev/null
  else
    docker start "$CONTAINER" >/dev/null
  fi
  for _ in $(seq 60); do
    curl -fsS "http://127.0.0.1:${PORT}/minio/health/live" >/dev/null 2>&1 && break
    sleep 1
  done
  docker run --rm --network "$NETWORK" --entrypoint sh docker.io/minio/mc:latest -c \
    "mc alias set t http://minio:9000 ${ROOT_USER} ${ROOT_PASSWORD} >/dev/null && mc mb --ignore-existing t/${BUCKET} >/dev/null"
  echo "minio up on http://127.0.0.1:${PORT} (bucket ${BUCKET}, docker network ${NETWORK})"
  ;;
down)
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker network rm "$NETWORK" >/dev/null 2>&1 || true
  echo "minio down"
  ;;
env)
  if [ "${2:-}" = "--network" ]; then endpoint="http://minio:9000"; else endpoint="http://127.0.0.1:${PORT}"; fi
  echo "export CAMPFIRE_TEST_S3_ENDPOINT=${endpoint}"
  echo "export CAMPFIRE_TEST_S3_BUCKET=${BUCKET}"
  echo "export CAMPFIRE_TEST_S3_REGION=us-east-1"
  echo "export CAMPFIRE_TEST_S3_ACCESS_KEY_ID=${ROOT_USER}"
  echo "export CAMPFIRE_TEST_S3_SECRET_ACCESS_KEY=${ROOT_PASSWORD}"
  echo "export CAMPFIRE_TEST_S3_NETWORK=${NETWORK}"
  ;;
*)
  echo "usage: parity/bin/s3 [up|down|env [--network]]" >&2
  exit 1
  ;;
esac
