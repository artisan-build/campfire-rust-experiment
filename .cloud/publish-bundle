#!/usr/bin/env bash
# Builds the runtime bundle Laravel Cloud downloads at build time, and publishes it as a release
# asset. Cloud has no Rust runtime and its build step times out at 15 minutes, so the binary is
# built here and shipped whole (see main.go).
#
# The bundle is the production image's filesystem, trimmed to what the binary needs: its own glibc
# and loader, the Debian libraries libvips and ffmpeg were built against, libvips, the ffmpeg
# libraries, ffmpeg/ffprobe and wrappers that run them through the same loader, and the CA store.
#
#   .cloud/publish-bundle            # build, upload, and point .cloud/bundle-release at it
#
# Cloud runs on arm64 (probed 2026-10-01), so this must run on an arm64 Docker host.
set -euo pipefail

cd "$(dirname "$0")/.."
# `gh repo view` would resolve to the `upstream` remote, which is 37signals'.
repo=$(gh repo view "$(git remote get-url origin)" --json nameWithOwner --jq .nameWithOwner)
revision=$(git rev-parse --short HEAD)
tag="cloud-bundle-${revision}"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

docker build --platform linux/arm64 -t "campfire-rust:${revision}" \
  --build-arg APP_VERSION="cloud-${revision}" --build-arg GIT_REVISION="${revision}" .

container=$(docker create --platform linux/arm64 "campfire-rust:${revision}")
docker export "$container" | tar -x -C "$work" \
  --exclude='proc/*' --exclude='sys/*' --exclude='dev/*' --exclude='.dockerenv' 2>/dev/null || true
docker rm -f "$container" >/dev/null

out="$work/bundle"
for path in lib usr/lib usr/local/lib usr/local/bin etc/ssl; do
  mkdir -p "$out/$(dirname "$path")"
  cp -a "$work/$path" "$out/$path"
done

# ffmpeg and ffprobe are subprocesses, so they need the same loader the binary gets.
mkdir -p "$out/wrap"
for tool in ffmpeg ffprobe; do
  cat > "$out/wrap/$tool" <<WRAP
#!/bin/sh
root=\$(cd "\$(dirname "\$0")/.." && pwd)
exec "\$root/lib/aarch64-linux-gnu/ld-linux-aarch64.so.1" \\
  --library-path "\$root/lib/aarch64-linux-gnu:\$root/usr/lib/aarch64-linux-gnu:\$root/usr/local/lib" \\
  "\$root/usr/local/bin/$tool" "\$@"
WRAP
  chmod +x "$out/wrap/$tool"
done

asset="$work/campfire-bundle-linux-arm64.tar.gz"
tar -czf "$asset" -C "$out" .
if gh release view "$tag" --repo "$repo" >/dev/null 2>&1; then
  gh release upload "$tag" "$asset" --repo "$repo" --clobber
else
  gh release create "$tag" "$asset" --repo "$repo" --title "$tag" \
    --notes "Runtime bundle for Laravel Cloud, built from ${revision} for linux/arm64."
fi
echo "$tag" > .cloud/bundle-release
echo "published $tag ($(du -h "$asset" | cut -f1))"
